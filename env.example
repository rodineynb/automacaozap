# .env.example — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA suba o arquivo .env para qualquer repositório

# =============================================================
# CLOUDFLARE
# =============================================================

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ID do banco D1 (gerado ao criar o banco com wrangler)
CLOUDFLARE_D1_DATABASE_ID=

# Nome do banco D1
CLOUDFLARE_D1_DATABASE_NAME=whatsapp-platform

# Nome do bucket R2 (para armazenar imagens/comprovantes)
CLOUDFLARE_R2_BUCKET_NAME=whatsapp-platform-storage

# Namespace do KV (para cache e sessões)
CLOUDFLARE_KV_NAMESPACE_ID=

# =============================================================
# AUTENTICAÇÃO DO SISTEMA
# =============================================================

# Segredo para assinar tokens JWT (use uma string longa e aleatória)
JWT_SECRET=

# Tempo de expiração do token JWT (ex: 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# =============================================================
# SISTEMA
# =============================================================

# Ambiente (development / production)
NODE_ENV=development

# URL base do sistema em produção
APP_URL=

# =============================================================
# CREDENCIAIS PADRÃO
# (Geradas automaticamente no primeiro deploy)
# =============================================================

DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

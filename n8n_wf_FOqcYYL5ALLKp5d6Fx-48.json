res* â nÃ£o precisa \\nde nada alÃ©m de vontade de vender mais.\\n\\nEnquanto vocÃª cuida da famÃ­lia, o Instagram entrega seu doce pra \\nquem precisa. *Quando menos espera, o WhatsApp enche de pedido.*\\n\\nEsse treinamento Ã© vendido por *R$ 89,90* em qualquer lugar.\\n\\nMas como vocÃª acabou de garantir as receitas VIP â *sÃ³ atÃ© \\nmeia-noite de hoje* â eu consigo liberar por apenas *R$ 14,90.*\\n\\nAmanhÃ£ esse valor some de vez.\\n\\nFaz o PIX agora e me manda o comprovante que libero tudo no mesmo \\nacesso das suas receitas na hora! ð\\n\\n*Chave PIX:*\\n61982277206\"}},\"type\":\"@n8n/n8n-nodes-langchain.agent\",\"typeVersion\":3.1,\"position\":[-528,-64],\"id\":\"d39d6f65-9d9e-4a1c-b057-69f22d3b8833\",\"name\":\"AI Agent\",\"retryOnFail\":true,\"waitBetweenTries\":5000},{\"parameters\":{\"modelName\":\"models/gemini-2.5-flash-lite\",\"options\":{}},\"type\":\"@n8n/n8n-nodes-langchain.lmChatGoogleGemini\",\"typeVersion\":1,\"position\":[-480,176],\"id\":\"e0f5e706-4acf-466a-82f3-ee33dd22d7d7\",\"name\":\"rodineynb\",\"retryOnFail\":true,\"waitBetweenTries\":3000},{\"parameters\":{\"model\":\"grok-4-1-fast-reasoning\",\"options\":{}},\"type\":\"@n8n/n8n-nodes-langchain.lmChatXAiGrok\",\"typeVersion\":1,\"position\":[-960,192],\"id\":\"a1124d7c-261b-47bb-ba67-badf0de89ee8\",\"name\":\"xAI Grok Chat Model\",\"disabled\":true},{\"parameters\":{\"sessionIdType\":\"customKey\",\"sessionKey\":\"={{ $('Entrada').item.json['lead.telefone'] }}\",\"tableName\":\"memoria_recheios\",\"contextWindowLength\":50},\"type\":\"@n8n/n8n-nodes-langchain.memoryPostgresChat\",\"typeVersion\":1.3,\"position\":[-368,176],\"id\":\"0b98a74b-5af9-446a-92c4-0c183939bc53\",\"name\":\"memoriaRecheios\"},{\"parameters\":{\"content\":\"# UPSSEL\",\"height\":512,\"width\":1920,\"color\":5},\"type\":\"n8n-nodes-base.stickyNote\",\"position\":[-1136,-128],\"typeVersion\":1,\"id\":\"49ee0232-3ee0-4e95-a906-b3720c399526\",\"name\":\"Sticky Note2\"},{\"parameters\":{\"workflowInputs\":{\"values\":[{\"name\":\"lead.telefone\"},{\"name\":\"token\"}]}},\"type\":\"n8n-nodes-base.executeWorkflowTrigger\",\"typeVersion\":1.1,\"position\":[-1104,-64],\"id\":\"ac433d21-e9ef-4dc5-9439-28ad7ad923a1\",\"name\":\"Entrada\"},{\"parameters\":{\"options\":{}},\"id\":\"f89e93c7-fbbb-485e-ba4f-1812d9497a3c\",\"name\":\"Loop Over Items\",\"type\":\"n8n-nodes-base.splitInBatches\",\"typeVersion\":3,\"position\":[0,-64]},{\"parameters\":{\"amount\":2},\"id\":\"17d9ee90-21f1-4ec8-a873-c21467a739f7\",\"name\":\"intervaloPartes1\",\"type\":\"n8n-nodes-base.wait\",\"typeVersion\":1.1,\"position\":[384,80],\"webhookId\":\"52d0e210-039f-4eb3-859b-2e285671228a\"},{\"parameters\":{\"model\":\"deepseek-v4-flash\",\"options\":{}},\"type\":\"@n8n/n8n-nodes-langchain.lmChatDeepSeek\",\"typeVersion\":1,\"position\":[-592,176],\"id\":\"f8aef31e-b120-4cc4-af9d-df8f2fd49781\",\"name\":\"DeepSeek\"},{\"parameters\":{\"amount\":10,\"unit\":\"minutes\"},\"type\":\"n8n-nodes-base.wait\",\"typeVersion\":1.1,\"position\":[-960,-64],\"id\":\"e69ef667-ef87-483f-a21c-8f3c44861be4\",\"name\":\"10min\",\"webhookId\":\"c9208dbf-bc10-43ef-a11a-87d0bb54ffb4\"},{\"parameters\":{\"jsCode\":\"const texto = $input.first().json.output;\\nif (!texto || typeof texto !== 'string') {\\n  throw new Error('O campo \\\"output\\\" nÃ£o foi encontrado, estÃ¡ vazio ou nÃ£o Ã© uma string.');\\n}\\n\\n// Passo 1: Converter \\\\n literal em quebra real ANTES de qualquer coisa\\nlet textoNormalizado = texto\\n  .replace(/\\\\\\\\n\\\\\\\\n/g, '\\\\n\\\\n')  // \\\\n\\\\n literal â linha em branco real\\n  .replace(/\\\\\\\\n/g, '\\\\n')       // \\\\n literal â quebra real\\n  .replace(/\\\\r\\\\n/g, '\\\\n')\\n  .replace(/\\\\r/g, '\\\\n');\\n\\n// Passo 2: Mascarar domÃ­nios\\nconst domainRegex = /\\\\b(?:(?!\\\\d\\\\.\\\\d)(?:[a-zA-Z][\\\\w-]*)\\\\.)+(?:[a-zA-Z]{2,})(?:\\\\.[a-zA-Z]{2,})?\\\\b/g;\\nlet textoMascarado = textoNormalizado.replace(domainRegex, m => m.replace(/\\\\./g, '_DOT_'));\\n\\n// Passo 3: Converter **texto** em *texto*\\nlet textoFormatado = textoMascarado.replace(/\\\\*\\\\*(.*?)\\\\*\\\\*/g, '*$1*');\\n\\n// Passo 4: Dividir preservando linhas em branco (nÃ£o filtrar linhas vazias!)\\nlet linhas = textoFormatado.split('\\\\n');\\n\\n// Passo 5: Transformar em sentenÃ§as preservando linhas em branco\\nconst sentenceSplitRegex = /(?<!Dr\\\\.)(?<!Dra\\\\.)(?<=[.!?])\\\\s+(?=[A-ZÃÃÃÃÃÃÃÃÃÃÃÃÃÃÃÃ])/;\\nlet sentencas = [];\\nlinhas.forEach(linha => {\\n  // Preserva linhas em branco como separador\\n  if (linha.trim().length === 0) {\\n    sentencas.push('');\\n    return;\\n  }\\n  if (linha.trim().startsWith('- ')) {\\n    sentencas.push(linha.trim().slice(2).trim());\\n  } else if (/^[0-9]+\\\\.\\\\s+/.test(linha.trim())) {\\n    sentencas.push(linha.trim().replace(/^[0-9]+\\\\.\\\\s+/, '').trim());\\n  } else {\\n    sentencas.push(\\n      ...linha.trim()\\n        .split(sentenceSplitRegex)\\n        .map(p => p.trim())\\n        .filter(p => p.length > 0)\\n    );\\n  }\\n});\\n\\n// Passo 6: Cortar sentenÃ§as > 300 chars sem quebrar palavras\\nconst MAX_LENGTH = 300;\\nlet resultados = [];\\nsentencas.forEach(s => {\\n  // Preserva linhas em branco\\n  if (s === '') {\\n    resultados.push('');\\n    return;\\n  }\\n  const t = s.trim();\\n  if (t.length <= MAX_LENGTH) {\\n    resultados.push(t);\\n  } else {\\n    let buffer = '';\\n    t.split(' ').forEach(p => {\\n      const tentativa = buffer ? `${buffer} ${p}` : p;\\n      if (tentativa.length > MAX_LENGTH) {\\n        resultados.push(buffer);\\n        buffer = p;\\n      } else {\\n        buffer = tentativa;\\n      }\\n    });\\n    if (buffer) resultados.push(buffer);\\n  }\\n});\\n\\n// Passo 7: Reverter \\\"_DOT_\\\" para \\\".\\\"\\nlet revertidos = resultados.map(r => r.replace(/_DOT_/g, '.'));\\n\\n// Passo 8: Converter **texto** em *texto*\\nlet ajustados = revertidos.map(r => r.replace(/\\\\*\\\\*(.*?)\\\\*\\\\*/g, '*$1*'));\\n\\n// Passo 9: Dividir em 3 blocos proporcionais respeitando linhas em branco\\nconst total = ajustados.length;\\nconst corte1 = Math.floor(total / 3);\\nconst corte2 = Math.floor(total * 2 / 3);\\n\\nconst bloco1 = ajustados.slice(0, corte1).join('\\\\n');\\nconst bloco2 = ajustados.slice(corte1, corte2).join('\\\\n');\\nconst bloco3 = ajustados.slice(corte2).join('\\\\n');\\n\\nreturn [\\n  { json: { parte: bloco1 } },\\n  { json: { parte: bloco2 } },\\n  { json: { parte: bloco3 } },\\n];\"},\"type\":\"n8n-nodes-base.code\",\"typeVersion\":2,\"position\":[-240,-64],\"id\":\"f8e6c1ef-0ac7-41a4-9023-c5f1a87c157b\",\"name\":\"particionaMensagem3\",\"notesInFlow\":true,\"notes\":\"descriÃ§Ã£o passo a passo em portuguÃªs do que esse script faz:\\n\\nValidaÃ§Ã£o de entrada\\n\\nLÃª texto de $json.output e lanÃ§a erro se nÃ£o existir ou nÃ£o for string.\\n\\nMascaramento de domÃ­nios\\n\\nUsa uma regex para identificar domÃ­nios (ex.: exemplo.com.br) e substitui cada ponto por _DOT_ para evitar quebras indesejadas (pontos dentro de nÃºmeros continuam â.â).\\n\\nQuebra em linhas nÃ£o vazias\\n\\nDivide o texto mascarado em linhas, remove espaÃ§os extras e filtra linhas vazias.\\n\\nTransformaÃ§Ã£o de linhas em sentenÃ§as\\n\\nPara cada linha:\\n\\nSe comeÃ§a com - : remove o traÃ§o e trata como uma sentenÃ§a Ãºnica.\\n\\nSe Ã© numerada (ex.: 1. Texto): remove o Ã­ndice e trata como sentenÃ§a.\\n\\nCaso contrÃ¡rio: aplica um split inteligente usando a regex\\n\\n/(?<!Dr\\\\.)(?<!Dra\\\\.)(?<=[.!?])\\\\s+(?=[A-ZÃÃÃÃÃÃÃÃÃÃÃÃÃÃÃÃ])/\\nâ SÃ³ quebra apÃ³s . ! ? seguido de espaÃ§o quando o prÃ³ximo caractere for maiÃºsculo e nÃ£o vier logo depois de abreviaÃ§Ãµes como Dr. ou Dra..\\nâ Garante que âDra. Gabrielaâ nÃ£o seja dividida, mas divide normalmente frases como âOlÃ¡. Tudo bem?â.\\n\\nCorte de sentenÃ§as longas\\n\\nLimita cada sentenÃ§a a no mÃ¡ximo 300 caracteres, sem quebrar palavras no meio:\\n\\nSe a sentenÃ§a excede 300 chars, constrÃ³i um buffer palavra a palavra; se
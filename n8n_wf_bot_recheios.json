iaRecheios"},{"parameters":{"amount":2},"id":"377c492c-5574-470e-8073-8e28cc3b5d54","name":"intervaloPartes","type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[4640,528],"webhookId":"52d0e210-039f-4eb3-859b-2e285671228a"},{"parameters":{"options":{}},"id":"589d67ae-f02b-441a-affe-0c144f071d92","name":"Loop Over Items","type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[4256,384]},{"parameters":{"jsCode":"const texto = $input.first().json.output;\nif (!texto || typeof texto !== 'string') {\n  throw new Error('O campo \"output\" nÃ£o foi encontrado, estÃ¡ vazio ou nÃ£o Ã© uma string.');\n}\n\n// Passo 1: Regex para domÃ­nios com mÃºltiplos sufixos\nconst domainRegex = /\\b(?:(?!\\d\\.\\d)(?:[a-zA-Z][\\w-]*)\\.)+(?:[a-zA-Z]{2,})(?:\\.[a-zA-Z]{2,})?\\b/g;\n\n// Passo 2: Mascarar domÃ­nios trocando \".\" por \"_DOT_\"\nlet textoMascarado = texto.replace(domainRegex, m => m.replace(/\\./g, '_DOT_'));\n\n// Passo 3: Quebrar em linhas nÃ£o vazias\nlet linhas = textoMascarado\n  .split('\\n')\n  .map(l => l.trim())\n  .filter(l => l.length > 0);\n\n// Passo 4: Transformar linhas em sentenÃ§as (sem quebrar âDra. Gabrielaâ)\nconst sentenceSplitRegex = /(?<!Dr\\.)(?<!Dra\\.)(?<=[.!?])\\s+(?=[A-ZÃÃÃÃÃÃÃÃÃÃÃÃÃÃÃÃ])/;\nlet sentencas = [];\nlinhas.forEach(linha => {\n  if (linha.startsWith('- ')) {\n    sentencas.push(linha.slice(2).trim());\n  }\n  else if (/^[0-9]+\\.\\s+/.test(linha)) {\n    sentencas.push(linha.replace(/^[0-9]+\\.\\s+/, '').trim());\n  }\n  else {\n    sentencas.push(\n      ...linha\n        .split(sentenceSplitRegex)\n        .map(p => p.trim())\n        .filter(p => p.length > 0)\n    );\n  }\n});\n\n// Passo 5: Cortar sentenÃ§as > 300 chars sem quebrar palavras\nconst MAX_LENGTH = 300;\nlet resultados = [];\nsentencas.forEach(s => {\n  const t = s.trim();\n  if (t.length <= MAX_LENGTH) {\n    resultados.push(t);\n  } else {\n    let buffer = '';\n    t.split(' ').forEach(p => {\n      const tentativa = buffer ? `${buffer} ${p}` : p;\n      if (tentativa.length > MAX_LENGTH) {\n        resultados.push(buffer);\n        buffer = p;\n      } else {\n        buffer = tentativa;\n      }\n    });\n    if (buffer) resultados.push(buffer);\n  }\n});\n\n// Passo 6: Reverter \"_DOT_\" para \".\"\nlet revertidos = resultados.map(r => r.replace(/_DOT_/g, '.'));\n\n// Passo 7: Converter **texto** em *texto*\nlet ajustados = revertidos.map(r => r.replace(/\\*\\*(.*?)\\*\\*/g, '*$1*'));\n\n// Passo 8: Retornar sÃ³ as partes de texto\nreturn ajustados.map(parte => ({ json: { parte } }));"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[3984,384],"id":"ede97748-b0da-4b33-b5f3-88719f77ef1e","name":"particionaMensagem2","notesInFlow":true,"notes":"descriÃ§Ã£o passo a passo em portuguÃªs do que esse script faz:\n\nValidaÃ§Ã£o de entrada\n\nLÃª texto de $json.output e lanÃ§a erro se nÃ£o existir ou nÃ£o for string.\n\nMascaramento de domÃ­nios\n\nUsa uma regex para identificar domÃ­nios (ex.: exemplo.com.br) e substitui cada ponto por _DOT_ para evitar quebras indesejadas (pontos dentro de nÃºmeros continuam â.â).\n\nQuebra em linhas nÃ£o vazias\n\nDivide o texto mascarado em linhas, remove espaÃ§os extras e filtra linhas vazias.\n\nTransformaÃ§Ã£o de linhas em sentenÃ§as\n\nPara cada linha:\n\nSe comeÃ§a com - : remove o traÃ§o e trata como uma sentenÃ§a Ãºnica.\n\nSe Ã© numerada (ex.: 1. Texto): remove o Ã­ndice e trata como sentenÃ§a.\n\nCaso contrÃ¡rio: aplica um split inteligente usando a regex\n\n/(?<!Dr\\.)(?<!Dra\\.)(?<=[.!?])\\s+(?=[A-ZÃÃÃÃÃÃÃÃÃÃÃÃÃÃÃÃ])/\nâ SÃ³ quebra apÃ³s . ! ? seguido de espaÃ§o quando o prÃ³ximo caractere for maiÃºsculo e nÃ£o vier logo depois de abreviaÃ§Ãµes como Dr. ou Dra..\nâ Garante que âDra. Gabrielaâ nÃ£o seja dividida, mas divide normalmente frases como âOlÃ¡. Tudo bem?â.\n\nCorte de sentenÃ§as longas\n\nLimita cada sentenÃ§a a no mÃ¡ximo 300 caracteres, sem quebrar palavras no meio:\n\nSe a sentenÃ§a excede 300 ch
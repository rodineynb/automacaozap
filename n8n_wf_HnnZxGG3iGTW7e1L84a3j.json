ce(/\\./g, '_DOT_'));\n\n// Passo 3: Converter **texto** em *texto*\nlet textoFormatado = textoMascarado.replace(/\\*\\*(.*?)\\*\\*/g, '*$1*');\n\n// Passo 4: Dividir preservando linhas em branco (nÃ£o filtrar linhas vazias!)\nlet linhas = textoFormatado.split('\\n');\n\n// Passo 5: Transformar em sentenÃ§as preservando linhas em branco\nconst sentenceSplitRegex = /(?<!Dr\\.)(?<!Dra\\.)(?<=[.!?])\\s+(?=[A-ZÃÃÃÃÃÃÃÃÃÃÃÃÃÃÃÃ])/;\nlet sentencas = [];\nlinhas.forEach(linha => {\n  // Preserva linhas em branco como separador\n  if (linha.trim().length === 0) {\n    sentencas.push('');\n    return;\n  }\n  if (linha.trim().startsWith('- ')) {\n    sentencas.push(linha.trim().slice(2).trim());\n  } else if (/^[0-9]+\\.\\s+/.test(linha.trim())) {\n    sentencas.push(linha.trim().replace(/^[0-9]+\\.\\s+/, '').trim());\n  } else {\n    sentencas.push(\n      ...linha.trim()\n        .split(sentenceSplitRegex)\n        .map(p => p.trim())\n        .filter(p => p.length > 0)\n    );\n  }\n});\n\n// Passo 6: Cortar sentenÃ§as > 300 chars sem quebrar palavras\nconst MAX_LENGTH = 300;\nlet resultados = [];\nsentencas.forEach(s => {\n  // Preserva linhas em branco\n  if (s === '') {\n    resultados.push('');\n    return;\n  }\n  const t = s.trim();\n  if (t.length <= MAX_LENGTH) {\n    resultados.push(t);\n  } else {\n    let buffer = '';\n    t.split(' ').forEach(p => {\n      const tentativa = buffer ? `${buffer} ${p}` : p;\n      if (tentativa.length > MAX_LENGTH) {\n        resultados.push(buffer);\n        buffer = p;\n      } else {\n        buffer = tentativa;\n      }\n    });\n    if (buffer) resultados.push(buffer);\n  }\n});\n\n// Passo 7: Reverter \"_DOT_\" para \".\"\nlet revertidos = resultados.map(r => r.replace(/_DOT_/g, '.'));\n\n// Passo 8: Converter **texto** em *texto*\nlet ajustados = revertidos.map(r => r.replace(/\\*\\*(.*?)\\*\\*/g, '*$1*'));\n\n// Passo 9: Dividir em 3 blocos proporcionais respeitando linhas em branco\nconst total = ajustado
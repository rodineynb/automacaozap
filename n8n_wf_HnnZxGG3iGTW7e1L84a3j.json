pe":"n8n-nodes-base.wait","typeVersion":1.1,"position":[1504,-656],"id":"e51bc557-a2ee-49c4-b632-50274f59405b","name":"12h","webhookId":"02623afd-45b6-4542-bc54-f31618d39ca4"},{"parameters":{"jsCode":"const texto = $input.first().json.output;\nif (!texto || typeof texto !== 'string') {\n  throw new Error('O campo \"output\" nÃ£o foi encontrado, estÃ¡ vazio ou nÃ£o Ã© uma string.');\n}\n\n// Passo 1: Converter \\n literal em quebra real ANTES de qualquer coisa\nlet textoNormalizado = texto\n  .replace(/\\\\n\\\\n/g, '\\n\\n')  // \\n\\n literal â linha em branco real\n  .replace(/\\\\n/g, '\\n')       // \\n literal â quebra real\n  .replace(/\\r\\n/g, '\\n')\n  .replace(/\\r/g, '\\n');\n\n// Passo 2: Mascarar domÃ­nios\nconst domainRegex = /\\b(?:(?!\\d\\.\\d)(?:[a-zA-Z][\\w-]*)\\.)+(?:[a-zA-Z]{2,})(?:\\.[a-zA-Z]{2,})?\\b/g;\nlet textoMascarado = textoNormalizado.replace(domainRegex, m => m.replace(/\\./g, '_DOT_'));\n\n// Passo 3: Converter **texto** em *texto*\nlet textoFormatado = textoMascarado.replace(/\\*\\*(.*?)\\*\\*/g, '*$1*');\n\n// Passo 4: Dividir preservando linhas em branco (nÃ£o filtrar linhas vazias!)\nlet linhas = textoFormatado.split('\\n');\n\n// Passo 5: Transformar em sentenÃ§as preservando linhas em branco\nconst sentenceSplitRegex = /(?<!Dr\\.)(?<!Dra\\.)(?<=[.!?])\\s+(?=[A-ZÃÃÃÃÃÃÃÃÃÃÃÃÃÃÃÃ])/;\nlet sentencas = [];\nlinhas.forEach(linha => {\n  // Preserva linhas em branco como separador\n  if (linha.trim().length === 0) {\n    sentencas.push('');\n    return;\n  }\n  if (linha.trim().startsWith('- ')) {\n    sentencas.push(linha.trim().slice(2).trim());\n  } else if (/^[0-9]+\\.\\s+/.test(linha.trim())) {\n    sentencas.push(linha.trim().replace(/^[0-9]+\\.\\s+/, '').trim());\n  } else {\n    sentencas.push(\n      ...linha.trim()\n        .split(sentenceSplitRegex)\n        .map(p => p.trim())\n        .filter(p => p.length > 0)\n    );\n  }\n});\n\n// Passo 6: Cortar sentenÃ§as > 300 chars sem quebrar palavras\nconst MAX_LENGTH = 300;\nlet resultados = [];\nsentencas.forEach(s => {\n  // Preserva linhas em branco\n  if (s === '') {\n    resultados.push('');\n    return;\n  }\n  const t = s.trim();\n  if (t.length <= MAX_LENGTH) {\n    resultados.push(t);\n  } else {\n    let buffer = '';\n    t.split(' ').forEach(p => {\n      const tentativa = buffer ? `${buffer} ${p}` : p;\n      if (tentativa.length > MAX_LENGTH) {\n        resultados.push(buffer);\n        buffer = p;\n      } else {\n        buffer = tentativa;\n      }\n    });\n    if (buffer) resultados.push(buffer);\n  }\n});\n\n// Passo 7: Reverter \"_DOT_\" para \".\"\nlet revertidos = resultados.map(r => r.replace(/_DOT_/g, '.'));\n\n// Passo 8: Converter **texto** em *texto*\nlet ajustados = revertidos.map(r => r.replace(/\\*\\*(.*?)\\*\\*/g, '*$1*'));\n\n// Passo 9: Dividir em 3 blocos proporcionais respeitando linhas em branco\nconst total = ajustados.length;\nconst corte1 = Math.floor(total / 3);\nconst corte2 = Math.floor(total * 2 / 3);\n\nconst bloco1 = ajustados.slice(0, corte1).join('\\n');\nconst bloco2 = ajustados.slice(corte1, corte2).join('\\n');\nconst bloco3 = ajustados.slice(corte2).join('\\n');\n\nreturn [\n  { json: { parte: bloco1 } },\n  { json: { parte: bloco2 } },\n  { json: { parte: bloco3 } },\n];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2880,-688],"id":"b4120e17-0c5a-469f-b141-6cbe80cf706c","name":"particionaMensagem3","notesInFlow":true,"notes":"descriÃ§Ã£o passo a passo em portuguÃªs do que esse script faz:\n\nValidaÃ§Ã£o de entrada\n\nLÃª texto de $json.output e lanÃ§a erro se nÃ£o existir ou nÃ£o for string.\n\nMascaramento de domÃ­nios\n\nUsa uma regex para identificar domÃ­nios (ex.: exemplo.com.br) e substitui cada ponto por _DOT_ para evitar quebras indesejadas (pontos dentro de nÃºmeros continuam â.â).\n\nQuebra em linhas nÃ£o vazias\n\nDivide o texto mascarado em linhas, remove espaÃ§os extras e filtra linhas vazias.\n\nTransformaÃ§Ã£o de linhas em sentenÃ§as\n\nPara cada linha:\n\nSe comeÃ§a com - : remove o traÃ§o e trata como uma sentenÃ§a Ãºnica.\n\nSe Ã© numerada (ex.: 1. Texto): remove o Ã­ndice e trata como sentenÃ§a.\n\nCaso contrÃ¡rio: aplica um split inteligente usando a regex\n\n/(?<!Dr\\.)(?<!Dra\\.)(?<=[.!?])\\s+(?=[A-ZÃÃÃÃÃÃÃÃÃÃÃÃÃÃÃÃ])/\nâ SÃ³ quebra apÃ³s . ! ? seguido de espaÃ§o quando o prÃ³ximo caractere for maiÃºsculo e nÃ£o vier logo depois de abreviaÃ§Ãµes como Dr. ou Dra..\nâ Garante que âDra. Gabrielaâ nÃ£o seja dividida, mas divide normalmente frases como âOlÃ¡. Tudo bem?â.\n\nCorte de sentenÃ§as longas\n\nLimita cada sentenÃ§a a no mÃ¡ximo 300 caracteres, sem quebrar palavras no meio:\n\nSe a sentenÃ§a excede 300 chars, constrÃ³i um buffer palavra a palavra; sempre que o buffer ultrapassa 300, adiciona-o Ã  lista e reinicia.\n\nRestauro dos domÃ­nios\n\nSubstitui _DOT_ de volta para . em cada parte resultante.\n\nAjuste de formataÃ§Ã£o em markdown\n\nConverte marcaÃ§Ãµes de negrito **texto** para itÃ¡lico *texto*.\n\nRetorno do resultado\n\nMonta o array final retornando, para cada parte, um objeto { json: { parte: \"...\" } }."},{"parameters":{"method":"POST","url":"=https://api-tbz.uazapi.com/send/text","sendHeaders":true,"headerParameters":{"parameters":[{"name":"=token","value":"={{ $('Entrada').item.json.token }}"}]},"sendBody":true,"bodyParameters":{"parameters":[{"name":"number","value":"={{ $('Entrada').item.json.telefone }}"},{"name":"text","value":"={{ $json.parte.replace(/\\n/g, \"\\n\") }}"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[3344,-512],"id":"88b0fbd5-0842-44b5-b834-84ceaa8c36aa","name":"RespostaLead2","retryOnFail":true,"waitBetweenTries":5000}],"connections":{"Entrada":{"main":[[{"node":"20min","type":"main","index":0}]]},"20min":{"main":[[{"node":"busca_acesso1","type":"main","index":0}]]},"busca_acesso1":{"main":[[{"node":"video","type":"main","index":0}]]},"busca_acesso2":{"main":[[{"node":"CalculaDeley","ty
  .split(sentenceSplitRegex)\n        .map(p => p.trim())\n        .filter(p => p.length > 0)\n    );\n  }\n});\n\n// Passo 6: Cortar sentenÃ§as > 300 chars sem quebrar palavras\nconst MAX_LENGTH = 300;\nlet resultados = [];\nsentencas.forEach(s => {\n  // Preserva linhas em branco\n  if (s === '') {\n    resultados.push('');\n    return;\n  }\n  const t = s.trim();\n  if (t.length <= MAX_LENGTH) {\n    resultados.push(t);\n  } else {\n    let buffer = '';\n    t.split(' ').forEach(p => {\n      const tentativa = buffer ? `${buffer} ${p}` : p;\n      if (tentativa.length > MAX_LENGTH) {\n        resultados.push(buffer);\n        buffer = p;\n      } else {\n        buffer = tentativa;\n      }\n    });\n    if (buffer) resultados.push(buffer);\n  }\n});\n\n// Passo 7: Reverter \"_DOT_\" para \".\"\nlet revertidos = resultados.map(r => r.replace(/_DOT_/g, '.'));\n\n// Passo 8: Converter **texto** em *texto*\nlet ajustados = revertidos.map(r => r.replace(/\\*\\*(.*?)\\*\\*/g, '*$1*'));\n\n// Passo 9: Dividir em 3 blocos proporcionais respeitando linhas em branco\nconst total = ajustados.length;\nconst corte1 = Math.floor(total / 3);\nconst corte2 = Math.floor(total * 2 / 3);\n\nconst bloco1 = ajustados.slice(0, corte1).join('\\n');\nconst bloco2 = ajustados.slice(corte1, corte2).join('\\n');\nconst bloco3 = ajustados.slice(corte2).join('\\n');\n\nreturn [\n  { json: { parte: bloco1 } },\n  { json: { parte: bloco2 } },\n  { json: { parte: bloco3 } },\n];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[896,208],"id":"96c3bde8-d795-4f44-a8ce-59ad5bc5305a","name":"particionaMensagem3","notesInFlow":true,"notes":"descriÃ§Ã£o passo a passo em portuguÃªs do que esse script faz:\n\nValidaÃ§Ã£o de entrada\n\nLÃª texto de $json.output e lanÃ§a erro se nÃ£o existir ou nÃ£o for string.\n\nMascaramento de domÃ­nios\n\nUsa uma regex para identificar domÃ­nios (ex.: exemplo.com.br) e substitui cada ponto por _DOT_ para evitar quebras indesejadas (pontos dentro de nÃºmeros
s = revertidos.map(r => r.replace(/\\*\\*(.*?)\\*\\*/g, '*$1*'));\n\n// Passo 9: Dividir em 3 blocos proporcionais respeitando linhas em branco\nconst total = ajustados.length;\nconst corte1 = Math.floor(total / 3);\nconst corte2 = Math.floor(total * 2 / 3);\n\nconst bloco1 = ajustados.slice(0, corte1).join('\\n');\nconst bloco2 = ajustados.slice(corte1, corte2).join('\\n');\nconst bloco3 = ajustados.slice(corte2).join('\\n');\n\nreturn [\n  { json: { parte: bloco1 } },\n  { json: { parte: bloco2 } },\n  { json: { parte: bloco3 } },\n];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[928,1136],"id":"62b3edf5-596a-4181-9044-d8b467dece09","name":"particionaMensagem4","notesInFlow":true,"notes":"descriÃ§Ã£o passo a passo em portuguÃªs do que esse script faz:\n\nValidaÃ§Ã£o de entrada\n\nLÃª texto de $json.output e lanÃ§a erro se nÃ£o existir ou nÃ£o for string.\n\nMascaramento de domÃ­nios\n\nUsa uma regex para identificar domÃ­nios (ex.: exemplo.com.br) e substitui cada ponto por _DOT_ para evitar quebras indesejadas (pontos dentro de nÃºmeros continuam â.â).\n\nQuebra em linhas nÃ£o vazias\n\nDivide o texto mascarado em linhas, remove espaÃ§os extras e filtra linhas vazias.\n\nTransformaÃ§Ã£o de linhas em sentenÃ§as\n\nPara cada linha:\n\nSe comeÃ§a com - : remove o traÃ§o e trata como uma sentenÃ§a Ãºnica.\n\nSe Ã© numerada (ex.: 1. Texto): remove o Ã­ndice e trata como sentenÃ§a.\n\nCaso contrÃ¡rio: aplica um split inteligente usando a regex\n\n/(?<!Dr\\.)(?<!Dra\\.)(?<=[.!?])\\s+(?=[A-ZÃÃÃÃÃÃÃÃÃÃÃÃÃÃÃÃ])/\nâ SÃ³ quebra apÃ³s . ! ? seguido de espaÃ§o quando o prÃ³ximo caractere for maiÃºsculo e nÃ£o vier logo depois de abreviaÃ§Ãµes como Dr. ou Dra..\nâ Garante que âDra. Gabrielaâ nÃ£o seja dividida, mas divide normalmente frases como âOlÃ¡. Tudo bem?â.\n\nCorte de sentenÃ§as longas\n\nLimita cada sentenÃ§a a no mÃ¡ximo 300 caracteres, sem quebrar palavras no meio:\n\nSe a sentenÃ§a excede 300 chars, constrÃ³i um buffer pa